NODE_ENV=development
PORT=3202

# Database
DATABASE_URL=postgresql://taskflow:taskflow_secret@localhost:5432/taskflow_dev?schema=public

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-output-of-openssl-rand-hex-32"
JWT_REFRESH_SECRET="replace-with-a-different-output-of-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL_WINDOW_MS="60000"
RATE_LIMIT_GLOBAL_MAX="100"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"
RATE_LIMIT_LOGIN_MAX="5"
